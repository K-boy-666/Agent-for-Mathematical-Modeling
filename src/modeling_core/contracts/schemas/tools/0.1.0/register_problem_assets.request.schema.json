{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.math-modeling-mcp.local/tools/0.1.0/register_problem_assets.request.schema.json",
  "title": "register_problem_assets request 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_id", "project_id", "asset_paths"],
  "properties": {
    "operation_id": {"$ref": "https://schemas.math-modeling-mcp.local/common/0.1.0/modeling-error.schema.json#/$defs/entityId"},
    "project_id": {"$ref": "https://schemas.math-modeling-mcp.local/common/0.1.0/modeling-error.schema.json#/$defs/entityId"},
    "asset_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "path"],
        "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 128},
          "path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}