{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.math-modeling-mcp.local/tools/0.1.0/validate_experiment.request.schema.json",
  "title": "validate_experiment request 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_id", "project_id", "attempt_id", "expected_result_hash", "validator_id", "policy_version", "policy"],
  "properties": {
    "operation_id": {"$ref": "https://schemas.math-modeling-mcp.local/common/0.1.0/modeling-error.schema.json#/$defs/entityId"},
    "project_id": {"$ref": "https://schemas.math-modeling-mcp.local/common/0.1.0/modeling-error.schema.json#/$defs/entityId"},
    "attempt_id": {"$ref": "https://schemas.math-modeling-mcp.local/common/0.1.0/modeling-error.schema.json#/$defs/entityId"},
    "expected_result_hash": {"$ref": "https://schemas.math-modeling-mcp.local/common/0.1.0/modeling-error.schema.json#/$defs/hash"},
    "validator_id": {"const": "numerical.root_finding.residual"},
    "policy_version": {"const": "0.1.0"},
    "policy": {"type": "object", "additionalProperties": false, "properties": {}},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000, "default": 10000}
  }
}
