{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.math-modeling-mcp.local/tools/0.1.0/get_project_status.result.schema.json",
  "title": "get_project_status result 0.1.0",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["tool_contract_version", "correlation_id", "server_time", "view", "project", "attempt_status_counts", "validation_status_counts", "registry_fingerprint", "last_activity_at", "experiments"],
      "properties": {
        "tool_contract_version": {"const": "modeling-tools/0.1.0"},
        "correlation_id": {"$ref": "#/$defs/entityId"},
        "server_time": {"$ref": "#/$defs/timestamp"},
        "view": {"const": "summary"},
        "project": {"$ref": "#/$defs/project"},
        "attempt_status_counts": {"$ref": "#/$defs/attemptCounts"},
        "validation_status_counts": {"$ref": "#/$defs/validationCounts"},
        "registry_fingerprint": {"$ref": "#/$defs/hash"},
        "last_activity_at": {"$ref": "#/$defs/timestamp"},
        "experiments": {
          "type": "object", "additionalProperties": false, "required": ["items", "truncated"],
          "properties": {"items": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/experimentSummary"}}, "truncated": {"type": "boolean"}}
        }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["tool_contract_version", "correlation_id", "server_time", "view", "project", "experiment", "trace"],
      "properties": {
        "tool_contract_version": {"const": "modeling-tools/0.1.0"},
        "correlation_id": {"$ref": "#/$defs/entityId"},
        "server_time": {"$ref": "#/$defs/timestamp"},
        "view": {"const": "experiment"},
        "project": {"$ref": "#/$defs/project"},
        "experiment": {"$ref": "#/$defs/experimentRecord"},
        "trace": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/attemptTrace"}, {"$ref": "#/$defs/validationTrace"}]}}
      }
    }
  ],
  "$defs": {
    "entityId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"},
    "project": {
      "type": "object", "additionalProperties": false, "required": ["project_id", "display_name", "project_format_version", "project_state", "created_at"],
      "properties": {"project_id": {"$ref": "#/$defs/entityId"}, "display_name": {"type": "string"}, "project_format_version": {"const": "modeling-project/0.1.0"}, "project_state": {"const": "READY"}, "created_at": {"$ref": "#/$defs/timestamp"}}
    },
    "attemptCounts": {
      "type": "object", "additionalProperties": false, "required": ["pending", "running", "succeeded", "numerical_failure", "errored", "timed_out", "abandoned"],
      "properties": {"pending": {"type": "integer", "minimum": 0}, "running": {"type": "integer", "minimum": 0}, "succeeded": {"type": "integer", "minimum": 0}, "numerical_failure": {"type": "integer", "minimum": 0}, "errored": {"type": "integer", "minimum": 0}, "timed_out": {"type": "integer", "minimum": 0}, "abandoned": {"type": "integer", "minimum": 0}}
    },
    "validationCounts": {
      "type": "object", "additionalProperties": false, "required": ["pending", "running", "succeeded", "errored", "timed_out", "abandoned"],
      "properties": {"pending": {"type": "integer", "minimum": 0}, "running": {"type": "integer", "minimum": 0}, "succeeded": {"type": "integer", "minimum": 0}, "errored": {"type": "integer", "minimum": 0}, "timed_out": {"type": "integer", "minimum": 0}, "abandoned": {"type": "integer", "minimum": 0}}
    },
    "experimentSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["experiment_id", "capability_id", "contract_version", "created_at", "attempt_count", "latest_attempt_id", "latest_attempt_status", "latest_attempt_at", "validation_count"],
      "properties": {
        "experiment_id": {"$ref": "#/$defs/entityId"}, "capability_id": {"type": "string"}, "contract_version": {"type": "string"}, "created_at": {"$ref": "#/$defs/timestamp"}, "attempt_count": {"type": "integer", "minimum": 1}, "latest_attempt_id": {"$ref": "#/$defs/entityId"}, "latest_attempt_status": {"enum": ["PENDING", "RUNNING", "SUCCEEDED", "NUMERICAL_FAILURE", "ERRORED", "TIMED_OUT", "ABANDONED"]}, "latest_attempt_at": {"$ref": "#/$defs/timestamp"}, "validation_count": {"type": "integer", "minimum": 0}
      }
    },
    "canonicalInput": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_input_schema_version", "expression_ast", "lower", "upper", "absolute_tolerance", "relative_tolerance", "function_tolerance", "max_iterations"],
      "properties": {
        "canonical_input_schema_version": {"const": "numerical.root_finding.canonical-input/0.1.0"},
        "expression_ast": {"$ref": "#/$defs/expressionNode"},
        "lower": {"type": "number"}, "upper": {"type": "number"}, "absolute_tolerance": {"type": "number"}, "relative_tolerance": {"type": "number"}, "function_tolerance": {"type": "number"}, "max_iterations": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "expressionNode": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "number"}, "value": {"type": "number"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": {"kind": {"const": "variable"}, "name": {"const": "x"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": {"kind": {"const": "constant"}, "name": {"enum": ["pi", "e"]}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "op", "operand"], "properties": {"kind": {"const": "unary"}, "op": {"enum": ["positive", "negative"]}, "operand": {"$ref": "#/$defs/expressionNode"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "op", "left", "right"], "properties": {"kind": {"const": "binary"}, "op": {"enum": ["add", "subtract", "multiply", "divide", "power"]}, "left": {"$ref": "#/$defs/expressionNode"}, "right": {"$ref": "#/$defs/expressionNode"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "name", "argument"], "properties": {"kind": {"const": "call"}, "name": {"enum": ["abs", "sqrt", "exp", "log", "sin", "cos", "tan"]}, "argument": {"$ref": "#/$defs/expressionNode"}}}
      ]
    },
    "experimentRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["experiment_id", "project_id", "capability_id", "contract_version", "canonical_input_schema_version", "canonical_payload", "canonical_payload_hash", "canonicalization_version", "model_snapshot_hash", "data_snapshot_references", "data_snapshot_set_hash", "execution_policy", "created_at"],
      "properties": {
        "experiment_id": {"$ref": "#/$defs/entityId"}, "project_id": {"$ref": "#/$defs/entityId"}, "capability_id": {"type": "string"}, "contract_version": {"type": "string"}, "canonical_input_schema_version": {"const": "numerical.root_finding.canonical-input/0.1.0"}, "canonical_payload": {"$ref": "#/$defs/canonicalInput"}, "canonical_payload_hash": {"$ref": "#/$defs/hash"}, "canonicalization_version": {"const": "canonical-json/0.1.0"}, "model_snapshot_hash": {"$ref": "#/$defs/hash"}, "data_snapshot_references": {"type": "array", "maxItems": 0}, "data_snapshot_set_hash": {"$ref": "#/$defs/hash"}, "execution_policy": {"type": "object", "additionalProperties": false, "required": ["timeout_ms", "seed"], "properties": {"timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000}, "seed": {"type": ["integer", "null"]}}}, "created_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "warning": {
      "type": "object", "additionalProperties": false, "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f]*$"}
      }
    },
    "environmentSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["python_version", "application_version", "lock_hash"],
      "properties": {
        "python_version": {"type": "string", "minLength": 1},
        "application_version": {"const": "0.1.0"},
        "lock_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "successData": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "function_value", "iterations", "evaluations", "termination_reason"],
      "properties": {
        "root": {"type": "number"},
        "function_value": {"type": "number"},
        "iterations": {"type": "integer", "minimum": 0},
        "evaluations": {"type": "integer", "minimum": 1, "maximum": 20000},
        "termination_reason": {"enum": ["endpoint_root", "residual_tolerance", "interval_tolerance"]}
      }
    },
    "failureData": {
      "type": "object", "additionalProperties": false,
      "required": ["failure_code", "iterations", "evaluations"],
      "properties": {
        "failure_code": {"enum": ["no_sign_change", "non_convergence", "domain_error", "non_finite_evaluation"]},
        "iterations": {"type": "integer", "minimum": 0},
        "evaluations": {"type": "integer", "minimum": 0, "maximum": 20000}
      }
    },
    "successPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["result_schema_version", "capability_id", "contract_version", "result_kind", "data"],
      "properties": {
        "result_schema_version": {"const": "modeling-result/0.1.0"},
        "capability_id": {"const": "numerical.root_finding"},
        "contract_version": {"const": "0.1.0"},
        "result_kind": {"const": "success"},
        "data": {"$ref": "#/$defs/successData"}
      }
    },
    "failurePayload": {
      "type": "object", "additionalProperties": false,
      "required": ["result_schema_version", "capability_id", "contract_version", "result_kind", "data"],
      "properties": {
        "result_schema_version": {"const": "modeling-result/0.1.0"},
        "capability_id": {"const": "numerical.root_finding"},
        "contract_version": {"const": "0.1.0"},
        "result_kind": {"const": "numerical_failure"},
        "data": {"$ref": "#/$defs/failureData"}
      }
    },
    "resultSuccessTrace": {
      "type": "object", "additionalProperties": false,
      "required": ["result_snapshot_id", "result_kind", "result_schema_version", "result_hash", "result_payload"],
      "properties": {
        "result_snapshot_id": {"$ref": "#/$defs/entityId"},
        "result_kind": {"const": "success"},
        "result_schema_version": {"const": "modeling-result/0.1.0"},
        "result_hash": {"$ref": "#/$defs/hash"},
        "result_payload": {"$ref": "#/$defs/successPayload"}
      }
    },
    "resultFailureTrace": {
      "type": "object", "additionalProperties": false,
      "required": ["result_snapshot_id", "result_kind", "result_schema_version", "result_hash", "result_payload"],
      "properties": {
        "result_snapshot_id": {"$ref": "#/$defs/entityId"},
        "result_kind": {"const": "numerical_failure"},
        "result_schema_version": {"const": "modeling-result/0.1.0"},
        "result_hash": {"$ref": "#/$defs/hash"},
        "result_payload": {"$ref": "#/$defs/failurePayload"}
      }
    },
    "attemptTrace": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "attempt_id", "experiment_id", "implementation_id", "implementation_version", "environment_summary", "randomness", "seed", "session_id", "status", "created_at", "started_at", "finished_at", "warnings", "result", "system_error", "numerical_failure", "terminal_reason"],
      "properties": {
        "record_type": {"const": "attempt"},
        "attempt_id": {"$ref": "#/$defs/entityId"},
        "experiment_id": {"$ref": "#/$defs/entityId"},
        "implementation_id": {"type": "string", "minLength": 1},
        "implementation_version": {"type": "string", "minLength": 1},
        "environment_summary": {"$ref": "#/$defs/environmentSummary"},
        "randomness": {"type": "string", "minLength": 1},
        "seed": {"type": ["integer", "null"], "minimum": -9007199254740991, "maximum": 9007199254740991},
        "session_id": {"$ref": "#/$defs/entityId"},
        "status": {"enum": ["PENDING", "RUNNING", "SUCCEEDED", "NUMERICAL_FAILURE", "ERRORED", "TIMED_OUT", "ABANDONED"]},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "started_at": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "finished_at": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}},
        "result": {"oneOf": [{"$ref": "#/$defs/resultSuccessTrace"}, {"$ref": "#/$defs/resultFailureTrace"}, {"type": "null"}]},
        "system_error": {"oneOf": [{"$ref": "https://schemas.math-modeling-mcp.local/common/0.1.0/modeling-error.schema.json"}, {"type": "null"}]},
        "numerical_failure": {"oneOf": [{"$ref": "#/$defs/failureData"}, {"type": "null"}]},
        "terminal_reason": {"enum": ["deadline_exceeded", "host_cancelled", "server_recovery", null]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "PENDING"}}}, "then": {"properties": {"started_at": {"type": "null"}, "finished_at": {"type": "null"}, "result": {"type": "null"}, "system_error": {"type": "null"}, "numerical_failure": {"type": "null"}, "terminal_reason": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "RUNNING"}}}, "then": {"properties": {"started_at": {"$ref": "#/$defs/timestamp"}, "finished_at": {"type": "null"}, "result": {"type": "null"}, "system_error": {"type": "null"}, "numerical_failure": {"type": "null"}, "terminal_reason": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "SUCCEEDED"}}}, "then": {"properties": {"started_at": {"$ref": "#/$defs/timestamp"}, "finished_at": {"$ref": "#/$defs/timestamp"}, "result": {"$ref": "#/$defs/resultSuccessTrace"}, "system_error": {"type": "null"}, "numerical_failure": {"type": "null"}, "terminal_reason": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "NUMERICAL_FAILURE"}}}, "then": {"properties": {"started_at": {"$ref": "#/$defs/timestamp"}, "finished_at": {"$ref": "#/$defs/timestamp"}, "result": {"$ref": "#/$defs/resultFailureTrace"}, "system_error": {"type": "null"}, "numerical_failure": {"$ref": "#/$defs/failureData"}, "terminal_reason": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "ERRORED"}}}, "then": {"properties": {"started_at": {"$ref": "#/$defs/timestamp"}, "finished_at": {"$ref": "#/$defs/timestamp"}, "result": {"type": "null"}, "system_error": {"$ref": "https://schemas.math-modeling-mcp.local/common/0.1.0/modeling-error.schema.json"}, "numerical_failure": {"type": "null"}, "terminal_reason": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "TIMED_OUT"}}}, "then": {"properties": {"started_at": {"$ref": "#/$defs/timestamp"}, "finished_at": {"$ref": "#/$defs/timestamp"}, "result": {"type": "null"}, "system_error": {"type": "null"}, "numerical_failure": {"type": "null"}, "terminal_reason": {"const": "deadline_exceeded"}}}},
        {"if": {"properties": {"status": {"const": "ABANDONED"}}}, "then": {"properties": {"finished_at": {"$ref": "#/$defs/timestamp"}, "result": {"type": "null"}, "system_error": {"type": "null"}, "numerical_failure": {"type": "null"}, "terminal_reason": {"enum": ["host_cancelled", "server_recovery"]}}}}
      ]
    },
    "validationMetrics": {
      "type": "object", "additionalProperties": false,
      "required": ["root_within_interval", "reported_function_value", "recomputed_function_value", "absolute_reported_delta", "absolute_residual", "function_tolerance", "failed_checks"],
      "properties": {
        "root_within_interval": {"type": "boolean"},
        "reported_function_value": {"type": "number"},
        "recomputed_function_value": {"type": ["number", "null"]},
        "absolute_reported_delta": {"type": ["number", "null"]},
        "absolute_residual": {"type": ["number", "null"]},
        "function_tolerance": {"type": "number"},
        "failed_checks": {"type": "array", "uniqueItems": true, "items": {"enum": ["root_out_of_interval", "expression_undefined", "non_finite_recomputed_value", "reported_value_mismatch", "residual_exceeds_tolerance"]}}
      }
    },
    "validationReportPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["report_schema_version", "validator_id", "validator_implementation_id", "validator_implementation_version", "policy_version", "policy", "policy_hash", "capability_id", "contract_version", "canonical_payload_hash", "model_snapshot_hash", "data_snapshot_set_hash", "result_hash", "outcome", "metrics"],
      "properties": {
        "report_schema_version": {"const": "modeling-validation-report/0.1.0"},
        "validator_id": {"const": "numerical.root_finding.residual"},
        "validator_implementation_id": {"type": "string", "minLength": 1},
        "validator_implementation_version": {"type": "string", "minLength": 1},
        "policy_version": {"const": "0.1.0"},
        "policy": {"type": "object", "additionalProperties": false},
        "policy_hash": {"$ref": "#/$defs/hash"},
        "capability_id": {"const": "numerical.root_finding"},
        "contract_version": {"const": "0.1.0"},
        "canonical_payload_hash": {"$ref": "#/$defs/hash"},
        "model_snapshot_hash": {"$ref": "#/$defs/hash"},
        "data_snapshot_set_hash": {"$ref": "#/$defs/hash"},
        "result_hash": {"$ref": "#/$defs/hash"},
        "outcome": {"enum": ["PASSED", "FAILED", "INCONCLUSIVE"]},
        "metrics": {"$ref": "#/$defs/validationMetrics"}
      }
    },
    "validationTrace": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "validation_id", "attempt_id", "expected_result_hash", "result_hash", "validator_id", "validator_implementation_id", "validator_implementation_version", "policy_version", "policy", "policy_hash", "status", "created_at", "started_at", "finished_at", "outcome", "metrics", "validation_report_hash", "report_payload", "operational_error", "terminal_reason"],
      "properties": {
        "record_type": {"const": "validation"},
        "validation_id": {"$ref": "#/$defs/entityId"},
        "attempt_id": {"$ref": "#/$defs/entityId"},
        "expected_result_hash": {"$ref": "#/$defs/hash"},
        "result_hash": {"$ref": "#/$defs/hash"},
        "validator_id": {"const": "numerical.root_finding.residual"},
        "validator_implementation_id": {"type": "string", "minLength": 1},
        "validator_implementation_version": {"type": "string", "minLength": 1},
        "policy_version": {"const": "0.1.0"},
        "policy": {"type": "object", "additionalProperties": false},
        "policy_hash": {"$ref": "#/$defs/hash"},
        "status": {"enum": ["PENDING", "RUNNING", "SUCCEEDED", "ERRORED", "TIMED_OUT", "ABANDONED"]},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "started_at": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "finished_at": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "outcome": {"enum": ["PASSED", "FAILED", "INCONCLUSIVE", null]},
        "metrics": {"oneOf": [{"$ref": "#/$defs/validationMetrics"}, {"type": "null"}]},
        "validation_report_hash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "report_payload": {"oneOf": [{"$ref": "#/$defs/validationReportPayload"}, {"type": "null"}]},
        "operational_error": {"oneOf": [{"$ref": "https://schemas.math-modeling-mcp.local/common/0.1.0/modeling-error.schema.json"}, {"type": "null"}]},
        "terminal_reason": {"enum": ["deadline_exceeded", "host_cancelled", "server_recovery", null]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "PENDING"}}}, "then": {"properties": {"started_at": {"type": "null"}, "finished_at": {"type": "null"}, "outcome": {"type": "null"}, "metrics": {"type": "null"}, "validation_report_hash": {"type": "null"}, "report_payload": {"type": "null"}, "operational_error": {"type": "null"}, "terminal_reason": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "RUNNING"}}}, "then": {"properties": {"started_at": {"$ref": "#/$defs/timestamp"}, "finished_at": {"type": "null"}, "outcome": {"type": "null"}, "metrics": {"type": "null"}, "validation_report_hash": {"type": "null"}, "report_payload": {"type": "null"}, "operational_error": {"type": "null"}, "terminal_reason": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "SUCCEEDED"}}}, "then": {"properties": {"started_at": {"$ref": "#/$defs/timestamp"}, "finished_at": {"$ref": "#/$defs/timestamp"}, "outcome": {"enum": ["PASSED", "FAILED", "INCONCLUSIVE"]}, "metrics": {"$ref": "#/$defs/validationMetrics"}, "validation_report_hash": {"$ref": "#/$defs/hash"}, "report_payload": {"$ref": "#/$defs/validationReportPayload"}, "operational_error": {"type": "null"}, "terminal_reason": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "ERRORED"}}}, "then": {"properties": {"started_at": {"$ref": "#/$defs/timestamp"}, "finished_at": {"$ref": "#/$defs/timestamp"}, "outcome": {"type": "null"}, "metrics": {"type": "null"}, "validation_report_hash": {"type": "null"}, "report_payload": {"type": "null"}, "operational_error": {"$ref": "https://schemas.math-modeling-mcp.local/common/0.1.0/modeling-error.schema.json"}, "terminal_reason": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "TIMED_OUT"}}}, "then": {"properties": {"started_at": {"$ref": "#/$defs/timestamp"}, "finished_at": {"$ref": "#/$defs/timestamp"}, "outcome": {"type": "null"}, "metrics": {"type": "null"}, "validation_report_hash": {"type": "null"}, "report_payload": {"type": "null"}, "operational_error": {"type": "null"}, "terminal_reason": {"const": "deadline_exceeded"}}}},
        {"if": {"properties": {"status": {"const": "ABANDONED"}}}, "then": {"properties": {"finished_at": {"$ref": "#/$defs/timestamp"}, "outcome": {"type": "null"}, "metrics": {"type": "null"}, "validation_report_hash": {"type": "null"}, "report_payload": {"type": "null"}, "operational_error": {"type": "null"}, "terminal_reason": {"enum": ["host_cancelled", "server_recovery"]}}}}
      ]
    }
  }
}
