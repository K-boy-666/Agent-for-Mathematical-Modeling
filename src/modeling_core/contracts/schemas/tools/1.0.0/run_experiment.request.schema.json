{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.math-modeling-mcp.local/tools/1.0.0/run_experiment.request.schema.json",
  "title": "run_experiment request 1.0.0",
  "oneOf": [
    {"$ref": "#/$defs/newRoot"},
    {"$ref": "#/$defs/newDynamics"},
    {"$ref": "#/$defs/rerunRoot"},
    {"$ref": "#/$defs/rerunDynamics"}
  ],
  "$defs": {
    "entityId": {"$ref": "https://schemas.math-modeling-mcp.local/common/1.0.0/modeling-error.schema.json#/$defs/entityId"},
    "hash": {"$ref": "https://schemas.math-modeling-mcp.local/common/1.0.0/modeling-error.schema.json#/$defs/hash"},
    "execution": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000, "default": 10000},
        "seed": {"type": ["integer", "null"], "minimum": -9007199254740991, "maximum": 9007199254740991, "default": null}
      }
    },
    "rootCapability": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_id", "contract_version"],
      "properties": {"capability_id": {"const": "numerical.root_finding"}, "contract_version": {"const": "1.0.0"}}
    },
    "dynamicsCapability": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_id", "contract_version"],
      "properties": {"capability_id": {"const": "dynamics.coupled_heave"}, "contract_version": {"const": "0.1.0"}}
    },
    "rootPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["expression", "lower", "upper"],
      "properties": {
        "expression": {"type": "string", "minLength": 1}, "lower": {"type": "number"}, "upper": {"type": "number"},
        "absolute_tolerance": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 1e-10},
        "relative_tolerance": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 1e-10},
        "function_tolerance": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 1e-10},
        "max_iterations": {"type": "integer", "minimum": 1, "maximum": 10000, "default": 100}
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "label", "sha256", "official_match"],
      "properties": {
        "snapshot_id": {"$ref": "#/$defs/entityId"}, "label": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}, "official_match": {"type": "boolean"}
      }
    },
    "dynamicsPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["subproblem_id", "mmir_revision", "damping_mode", "asset_snapshots"],
      "properties": {
        "subproblem_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "mmir_revision": {"$ref": "#/$defs/hash"},
        "damping_mode": {"enum": ["linear", "power_law"]},
        "asset_snapshots": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/asset"}}
      }
    },
    "newRoot": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "project_id", "mode", "capability", "payload"],
      "properties": {"operation_id": {"$ref": "#/$defs/entityId"}, "project_id": {"$ref": "#/$defs/entityId"}, "mode": {"const": "new"}, "capability": {"$ref": "#/$defs/rootCapability"}, "payload": {"$ref": "#/$defs/rootPayload"}, "execution": {"$ref": "#/$defs/execution"}}
    },
    "newDynamics": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "project_id", "mode", "capability", "payload"],
      "properties": {"operation_id": {"$ref": "#/$defs/entityId"}, "project_id": {"$ref": "#/$defs/entityId"}, "mode": {"const": "new"}, "capability": {"$ref": "#/$defs/dynamicsCapability"}, "payload": {"$ref": "#/$defs/dynamicsPayload"}, "execution": {"$ref": "#/$defs/execution"}}
    },
    "rerunRoot": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "project_id", "mode", "experiment_id", "capability", "payload"],
      "properties": {"operation_id": {"$ref": "#/$defs/entityId"}, "project_id": {"$ref": "#/$defs/entityId"}, "mode": {"const": "rerun"}, "experiment_id": {"$ref": "#/$defs/entityId"}, "capability": {"$ref": "#/$defs/rootCapability"}, "payload": {"$ref": "#/$defs/rootPayload"}, "execution": {"$ref": "#/$defs/execution"}}
    },
    "rerunDynamics": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "project_id", "mode", "experiment_id", "capability", "payload"],
      "properties": {"operation_id": {"$ref": "#/$defs/entityId"}, "project_id": {"$ref": "#/$defs/entityId"}, "mode": {"const": "rerun"}, "experiment_id": {"$ref": "#/$defs/entityId"}, "capability": {"$ref": "#/$defs/dynamicsCapability"}, "payload": {"$ref": "#/$defs/dynamicsPayload"}, "execution": {"$ref": "#/$defs/execution"}}
    }
  }
}
