{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.math-modeling-mcp.local/tools/1.0.0/put_subproblem_mmir.request.schema.json",
  "title": "put_subproblem_mmir request 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_id", "project_id", "subproblem_id", "mmir"],
  "properties": {
    "operation_id": {"$ref": "https://schemas.math-modeling-mcp.local/common/1.0.0/modeling-error.schema.json#/$defs/entityId"},
    "project_id": {"$ref": "https://schemas.math-modeling-mcp.local/common/1.0.0/modeling-error.schema.json#/$defs/entityId"},
    "subproblem_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "mmir": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "problem_id", "question_id", "assumptions"],
      "properties": {
        "schema_version": {"const": "modeling-mmir/0.1.0"},
        "problem_id": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "minLength": 1},
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "asset_labels": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "derivation": {"type": "string"},
        "parameters": {"type": "object"}
      }
    }
  }
}