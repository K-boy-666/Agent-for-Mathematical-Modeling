{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.math-modeling-mcp.local/tools/1.0.0/validate_experiment.result.schema.json",
  "title": "validate_experiment result 0.1.0",
  "oneOf": [
    {"$ref": "#/$defs/succeeded"},
    {"$ref": "#/$defs/errored"},
    {"$ref": "#/$defs/timedOut"},
    {"$ref": "#/$defs/abandoned"}
  ],
  "$defs": {
    "entityId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "role", "sha256", "media_type", "size_bytes", "project_relative_path"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/hash"}, "role": {"const": "validation_report"},
        "sha256": {"$ref": "#/$defs/hash"}, "media_type": {"const": "application/json"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "project_relative_path": {"type": "string", "pattern": "^\\.modeling/artifacts/sha256/[0-9a-f]{2}/[0-9a-f]{64}\\.json$"}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["root_within_interval", "reported_function_value", "recomputed_function_value", "absolute_reported_delta", "absolute_residual", "function_tolerance", "failed_checks"],
      "properties": {
        "root_within_interval": {"type": "boolean"}, "reported_function_value": {"type": "number"}, "recomputed_function_value": {"type": ["number", "null"]}, "absolute_reported_delta": {"type": ["number", "null"]}, "absolute_residual": {"type": ["number", "null"]}, "function_tolerance": {"type": "number"}, "failed_checks": {"type": "array", "items": {"enum": ["root_out_of_interval", "expression_undefined", "non_finite_recomputed_value", "reported_value_mismatch", "residual_exceeds_tolerance"]}, "uniqueItems": true}
      }
    },
    "succeeded": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_contract_version", "correlation_id", "server_time", "operation_id", "replayed", "validation_id", "attempt_id", "result_hash", "validator_id", "validator_implementation_id", "validator_implementation_version", "policy_version", "policy_hash", "validation_status", "outcome", "metrics", "validation_report_hash", "report_artifact"],
      "properties": {
        "tool_contract_version": {"const": "modeling-tools/1.0.0"}, "correlation_id": {"$ref": "#/$defs/entityId"}, "server_time": {"$ref": "#/$defs/timestamp"}, "operation_id": {"$ref": "#/$defs/entityId"}, "replayed": {"type": "boolean"}, "validation_id": {"$ref": "#/$defs/entityId"}, "attempt_id": {"$ref": "#/$defs/entityId"}, "result_hash": {"$ref": "#/$defs/hash"}, "validator_id": {"const": "numerical.root_finding.residual"}, "validator_implementation_id": {"type": "string"}, "validator_implementation_version": {"type": "string"}, "policy_version": {"const": "1.0.0"}, "policy_hash": {"$ref": "#/$defs/hash"}, "validation_status": {"const": "SUCCEEDED"}, "outcome": {"enum": ["PASSED", "FAILED", "INCONCLUSIVE"]}, "metrics": {"$ref": "#/$defs/metrics"}, "validation_report_hash": {"$ref": "#/$defs/hash"}, "report_artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "errored": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_contract_version", "correlation_id", "server_time", "operation_id", "replayed", "validation_id", "attempt_id", "result_hash", "validator_id", "validator_implementation_id", "validator_implementation_version", "policy_version", "policy_hash", "validation_status", "operational_error"],
      "properties": {
        "tool_contract_version": {"const": "modeling-tools/1.0.0"}, "correlation_id": {"$ref": "#/$defs/entityId"}, "server_time": {"$ref": "#/$defs/timestamp"}, "operation_id": {"$ref": "#/$defs/entityId"}, "replayed": {"type": "boolean"}, "validation_id": {"$ref": "#/$defs/entityId"}, "attempt_id": {"$ref": "#/$defs/entityId"}, "result_hash": {"$ref": "#/$defs/hash"}, "validator_id": {"const": "numerical.root_finding.residual"}, "validator_implementation_id": {"type": "string"}, "validator_implementation_version": {"type": "string"}, "policy_version": {"const": "1.0.0"}, "policy_hash": {"$ref": "#/$defs/hash"}, "validation_status": {"const": "ERRORED"}, "operational_error": {"$ref": "https://schemas.math-modeling-mcp.local/common/1.0.0/modeling-error.schema.json"}
      }
    },
    "timedOut": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_contract_version", "correlation_id", "server_time", "operation_id", "replayed", "validation_id", "attempt_id", "result_hash", "validator_id", "validator_implementation_id", "validator_implementation_version", "policy_version", "policy_hash", "validation_status", "terminal_reason"],
      "properties": {
        "tool_contract_version": {"const": "modeling-tools/1.0.0"}, "correlation_id": {"$ref": "#/$defs/entityId"}, "server_time": {"$ref": "#/$defs/timestamp"}, "operation_id": {"$ref": "#/$defs/entityId"}, "replayed": {"type": "boolean"}, "validation_id": {"$ref": "#/$defs/entityId"}, "attempt_id": {"$ref": "#/$defs/entityId"}, "result_hash": {"$ref": "#/$defs/hash"}, "validator_id": {"const": "numerical.root_finding.residual"}, "validator_implementation_id": {"type": "string"}, "validator_implementation_version": {"type": "string"}, "policy_version": {"const": "1.0.0"}, "policy_hash": {"$ref": "#/$defs/hash"}, "validation_status": {"const": "TIMED_OUT"}, "terminal_reason": {"const": "deadline_exceeded"}
      }
    },
    "abandoned": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_contract_version", "correlation_id", "server_time", "operation_id", "replayed", "validation_id", "attempt_id", "result_hash", "validator_id", "validator_implementation_id", "validator_implementation_version", "policy_version", "policy_hash", "validation_status", "terminal_reason"],
      "properties": {
        "tool_contract_version": {"const": "modeling-tools/1.0.0"}, "correlation_id": {"$ref": "#/$defs/entityId"}, "server_time": {"$ref": "#/$defs/timestamp"}, "operation_id": {"$ref": "#/$defs/entityId"}, "replayed": {"type": "boolean"}, "validation_id": {"$ref": "#/$defs/entityId"}, "attempt_id": {"$ref": "#/$defs/entityId"}, "result_hash": {"$ref": "#/$defs/hash"}, "validator_id": {"const": "numerical.root_finding.residual"}, "validator_implementation_id": {"type": "string"}, "validator_implementation_version": {"type": "string"}, "policy_version": {"const": "1.0.0"}, "policy_hash": {"$ref": "#/$defs/hash"}, "validation_status": {"const": "ABANDONED"}, "terminal_reason": {"enum": ["host_cancelled", "server_recovery"]}
      }
    }
  }
}
