{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.math-modeling-mcp.local/common/1.0.0/modeling-validator.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "validator_id",
    "supported_capabilities",
    "implementation_id",
    "implementation_version",
    "policy_version",
    "policy_schema",
    "report_schema",
    "summary"
  ],
  "properties": {
    "kind": {"const": "built_in"},
    "validator_id": {"type": "string", "minLength": 1},
    "supported_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/supportedCapabilityRange"}
    },
    "implementation_id": {"type": "string", "minLength": 1},
    "implementation_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "policy_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "policy_schema": {"$ref": "#/$defs/schemaReference"},
    "report_schema": {"$ref": "#/$defs/schemaReference"},
    "summary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "supportedCapabilityRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "minimum_contract_version",
        "maximum_contract_version"
      ],
      "properties": {
        "capability_id": {"type": "string", "minLength": 1},
        "minimum_contract_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "maximum_contract_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
      }
    },
    "schemaReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "schema", "schema_hash"],
      "properties": {
        "schema_version": {"type": "string", "minLength": 1},
        "schema": {"$ref": "#/$defs/rootObjectSchema"},
        "schema_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "rootObjectSchema": {
      "type": "object",
      "required": ["$schema", "$id", "type", "additionalProperties"],
      "properties": {
        "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
        "$id": {"type": "string", "minLength": 1},
        "type": {"const": "object"},
        "additionalProperties": {"const": false}
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}