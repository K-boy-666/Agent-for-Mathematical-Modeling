{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.math-modeling-mcp.local/common/1.0.0/modeling-error.schema.json",
  "title": "Modeling error 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["error_schema_version", "code", "message", "retryable", "correlation_id", "details"],
  "properties": {
    "error_schema_version": {"const": "modeling-error/1.0.0"},
    "code": {"enum": ["INVALID_REQUEST", "NOT_FOUND", "UNSUPPORTED_VERSION", "CONFLICT", "PRECONDITION_FAILED", "SECURITY_VIOLATION", "RESOURCE_LIMIT_EXCEEDED", "INTEGRITY_FAILURE", "INTERNAL_ERROR"]},
    "message": {"type": "string", "minLength": 1, "maxLength": 1024},
    "retryable": {"type": "boolean"},
    "correlation_id": {"$ref": "#/$defs/entityId"},
    "details": {
      "oneOf": [
        {"$ref": "#/$defs/invalidRequestDetails"},
        {"$ref": "#/$defs/notFoundDetails"},
        {"$ref": "#/$defs/unsupportedVersionDetails"},
        {"$ref": "#/$defs/conflictDetails"},
        {"$ref": "#/$defs/preconditionDetails"},
        {"$ref": "#/$defs/securityDetails"},
        {"$ref": "#/$defs/resourceDetails"},
        {"$ref": "#/$defs/integrityDetails"},
        {"$ref": "#/$defs/internalDetails"}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"code": {"const": "INVALID_REQUEST"}}}, "then": {"properties": {"details": {"$ref": "#/$defs/invalidRequestDetails"}}}},
    {"if": {"properties": {"code": {"const": "NOT_FOUND"}}}, "then": {"properties": {"details": {"$ref": "#/$defs/notFoundDetails"}}}},
    {"if": {"properties": {"code": {"const": "UNSUPPORTED_VERSION"}}}, "then": {"properties": {"details": {"$ref": "#/$defs/unsupportedVersionDetails"}}}},
    {"if": {"properties": {"code": {"const": "CONFLICT"}}}, "then": {"properties": {"details": {"$ref": "#/$defs/conflictDetails"}}}},
    {"if": {"properties": {"code": {"const": "PRECONDITION_FAILED"}}}, "then": {"properties": {"details": {"$ref": "#/$defs/preconditionDetails"}}}},
    {"if": {"properties": {"code": {"const": "SECURITY_VIOLATION"}}}, "then": {"properties": {"details": {"$ref": "#/$defs/securityDetails"}}}},
    {"if": {"properties": {"code": {"const": "RESOURCE_LIMIT_EXCEEDED"}}}, "then": {"properties": {"details": {"$ref": "#/$defs/resourceDetails"}}}},
    {"if": {"properties": {"code": {"const": "INTEGRITY_FAILURE"}}}, "then": {"properties": {"details": {"$ref": "#/$defs/integrityDetails"}}}},
    {"if": {"properties": {"code": {"const": "INTERNAL_ERROR"}}}, "then": {"properties": {"details": {"$ref": "#/$defs/internalDetails"}}}}
  ],
  "$defs": {
    "entityId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"},
    "invalidRequestDetails": {
      "type": "object", "additionalProperties": false, "required": ["field_path", "reason"],
      "properties": {
        "field_path": {"type": "string", "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"},
        "reason": {"enum": ["missing_required", "unknown_field", "invalid_type", "invalid_format", "out_of_range", "invalid_combination", "expression_parse_error", "capability_payload_violation", "invalid_cursor"]}
      }
    },
    "notFoundDetails": {
      "type": "object", "additionalProperties": false, "required": ["resource_type", "resource_id"],
      "properties": {"resource_type": {"type": "string", "minLength": 1}, "resource_id": {"type": "string", "minLength": 1}}
    },
    "unsupportedVersionDetails": {
      "type": "object", "additionalProperties": false, "required": ["subject", "requested_version", "supported_versions"],
      "properties": {"subject": {"type": "string", "minLength": 1}, "requested_version": {"type": "string", "minLength": 1}, "supported_versions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}
    },
    "conflictDetails": {
      "type": "object", "additionalProperties": false, "required": ["conflict_type"],
      "properties": {
        "conflict_type": {"enum": ["idempotency_mismatch", "operation_in_progress", "project_busy", "project_metadata_mismatch", "duplicate_registration"]},
        "existing_resource_id": {"type": "string"},
        "retry_after_ms": {"type": "integer", "minimum": 0}
      }
    },
    "preconditionDetails": {
      "type": "object", "additionalProperties": false, "required": ["condition", "current_state"],
      "properties": {"condition": {"enum": ["project_not_ready", "project_degraded", "attempt_not_succeeded", "missing_success_result", "validator_incompatible"]}, "current_state": {"type": "string"}}
    },
    "securityDetails": {
      "type": "object", "additionalProperties": false, "required": ["rule"],
      "properties": {"rule": {"enum": ["math_expr_forbidden_syntax", "path_outside_project", "unsafe_reparse_point", "stdout_protocol_violation"]}}
    },
    "resourceDetails": {
      "type": "object", "additionalProperties": false, "required": ["resource", "limit"],
      "properties": {
        "resource": {"enum": ["mcp_request_bytes", "inline_response_bytes", "expression_bytes", "ast_nodes", "ast_depth", "numeric_literal_chars", "function_evaluations", "warnings"]},
        "limit": {"type": "integer", "minimum": 0},
        "observed": {"type": "integer", "minimum": 0}
      }
    },
    "integrityDetails": {
      "type": "object", "additionalProperties": false, "required": ["subject"],
      "properties": {
        "subject": {"enum": ["project_metadata", "database_relation", "result_hash", "validation_report_hash", "input_snapshot", "artifact_content"]},
        "expected_hash": {"$ref": "#/$defs/hash"},
        "observed_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "internalDetails": {
      "type": "object", "additionalProperties": false, "required": ["event_id"],
      "properties": {"event_id": {"$ref": "#/$defs/entityId"}}
    }
  }
}
